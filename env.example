# Core runtime
NODE_ENV=development
PORT=5000

# Backend (Railway + Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated list of web origins allowed by CORS.
# Native app requests usually do not send Origin and are not blocked by this.
APP_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,https://app.example.com

# App API base URL
EXPO_PUBLIC_API_URL=http://localhost:5000

# RevenueCat (mobile client keys + backend webhook auth)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_WEBHOOK_SECRET=replace-with-a-strong-shared-secret

# Google OAuth
# Both variables must use the SAME Web application OAuth Client ID from Google Cloud Console.
# Go to: console.cloud.google.com → APIs & Services → Credentials → Create OAuth Client ID
#   Type: Web application
#   Authorized redirect URIs: https://auth.expo.io/@andersonpinto/medcontrol
#                             (for local dev add: http://localhost:19006)
# GOOGLE_CLIENT_ID   → backend (validates the id_token via google-auth-library)
# EXPO_PUBLIC_*      → frontend (passed to expo-auth-session at build time)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Suggested production values:
# NODE_ENV=production
# EXPO_PUBLIC_API_URL=https://api.example.com
